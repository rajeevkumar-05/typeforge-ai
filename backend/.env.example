# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/typeforge

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRES_IN=7d

# Frontend URL (for CORS and OAuth redirects)
CLIENT_URL=http://localhost:5173

# Google OAuth (get from Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Email (required for password reset; use an HTTPS provider on Render Free)
# Resend: verify your sender/domain in Resend and configure these privately on Render.
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# EMAIL_FROM=TypeForge <reset@your-verified-domain.example>
# SMTP alternative (standard SMTP ports are blocked on Render Free):
# EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
